# Public environment variables (safe to expose to browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MKULIMA

# Local Postgres (see docker-compose.yml — `npm run db:up`)
DATABASE_URL=postgresql://mkulima:mkulima@localhost:5432/mkulima

# Session signing secret
JWT_SECRET=change-me

# AI assistant — Gemini free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
